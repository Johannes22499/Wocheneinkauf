 "recipes": [
  {
   "id": "bolo",
   "name": "Spaghetti Bolognese",
   "min": 35,
   "ing": {
    "spaghetti": 125,
    "rinderhack": 125,
    "tomdose": 200,
    "zwiebeln": 50,
    "karotten": 50,
    "knoblauch": 1,
    "tommark": 20,
    "parmesan": 15,
    "oel": 10
   },
   "steps": "Zwiebel, Karotte und Knoblauch fein würfeln und anbraten. Hack krümelig braten, Tomatenmark kurz mitrösten, Tomaten dazu und 20 Minuten köcheln lassen. Mit Spaghetti und Käse servieren."
  },
  {
   "id": "hcurry",
   "name": "Hähnchen-Curry mit Reis",
   "min": 30,
   "ing": {
    "haehnchen": 150,
    "reis": 80,
    "kokos": 100,
    "paprika": 0.5,
    "zwiebeln": 50,
    "brokkoli": 0.25,
    "oel": 10
   },
   "steps": "Reis kochen. Hähnchen in Stücke schneiden und anbraten, Zwiebel, Paprika und Brokkoli dazu. Mit Currypulver bestäuben, Kokosmilch angießen und 10 Minuten köcheln."
  },
  {
   "id": "kzpfanne",
   "name": "Kartoffel-Zucchini-Pfanne mit Kräuterquark",
   "min": 30,
   "ing": {
    "kartoffeln": 300,
    "zucchini": 0.5,
    "zwiebeln": 40,
    "quark": 125,
    "oel": 15
   },
   "steps": "Kartoffeln würfeln und goldbraun braten, Zucchini und Zwiebel die letzten 8 Minuten mitbraten. Quark mit Salz, Pfeffer und Kräutern verrühren und dazu reichen."
  },
  {
   "id": "kuerbis",
   "name": "Kürbissuppe mit Kokos",
   "min": 35,
   "ing": {
    "kuerbis": 0.33,
    "karotten": 100,
    "kartoffeln": 100,
    "zwiebeln": 40,
    "kokos": 100,
    "bruehe": 6,
    "oel": 5
   },
   "steps": "Kürbis (mit Schale), Karotten, Kartoffeln und Zwiebel würfeln, andünsten und mit Brühe bedecken. 20 Minuten kochen, Kokosmilch dazu und fein pürieren."
  },
  {
   "id": "chilisin",
   "name": "Chili sin Carne mit Reis",
   "min": 35,
   "ing": {
    "kidney": 130,
    "mais": 95,
    "tomdose": 200,
    "paprika": 0.5,
    "zwiebeln": 50,
    "knoblauch": 1,
    "reis": 70,
    "oel": 10
   },
   "steps": "Zwiebel, Knoblauch und Paprika anbraten. Tomaten, abgespülte Bohnen und Mais dazu, mit Kreuzkümmel und Paprikapulver würzen und 20 Minuten köcheln. Mit Reis servieren."
  },
  {
   "id": "chilicon",
   "name": "Chili con Carne mit Reis",
   "min": 40,
   "ing": {
    "rinderhack": 125,
    "kidney": 130,
    "mais": 95,
    "tomdose": 200,
    "zwiebeln": 50,
    "knoblauch": 1,
    "reis": 70,
    "oel": 10
   },
   "steps": "Hack krümelig anbraten, Zwiebel und Knoblauch dazu. Tomaten, Bohnen und Mais einrühren, kräftig würzen und 25 Minuten köcheln. Mit Reis servieren."
  },
  {
   "id": "dal",
   "name": "Rotes Linsen-Dal mit Reis",
   "min": 30,
   "ing": {
    "linsen": 80,
    "kokos": 100,
    "tomdose": 100,
    "zwiebeln": 40,
    "knoblauch": 1,
    "reis": 70,
    "oel": 10
   },
   "steps": "Zwiebel und Knoblauch anschwitzen, Currypulver kurz mitrösten. Linsen, Tomaten, Kokosmilch und 200 ml Wasser dazu und 15 Minuten sämig köcheln. Mit Reis servieren."
  },
  {
   "id": "lachs",
   "name": "Ofenlachs mit Kartoffeln und Brokkoli",
   "min": 35,
   "ing": {
    "lachs": 125,
    "kartoffeln": 250,
    "brokkoli": 0.4,
    "butter": 10,
    "oel": 10
   },
   "steps": "Kartoffeln halbieren, mit Öl bei 200 °C 15 Minuten backen. Lachs und Brokkoli dazulegen, Butterflocken darauf und weitere 15 Minuten garen."
  },
  {
   "id": "gnocchi",
   "name": "Gnocchi-Pfanne mit Spinat und Feta",
   "min": 20,
   "ing": {
    "gnocchi": 250,
    "spinat": 150,
    "feta": 50,
    "zwiebeln": 30,
    "knoblauch": 1,
    "oel": 10
   },
   "steps": "Gnocchi in Öl knusprig braten. Zwiebel und Knoblauch dazu, aufgetauten Spinat unterheben und heiß werden lassen. Feta darüberbröseln."
  },
  {
   "id": "lasagne",
   "name": "Lasagne Bolognese",
   "min": 70,
   "ing": {
    "lasagne": 80,
    "hack": 125,
    "tomdose": 200,
    "zwiebeln": 40,
    "milch": 150,
    "butter": 15,
    "mehl": 15,
    "gouda": 40,
    "oel": 5
   },
   "steps": "Hack mit Zwiebel anbraten, Tomaten dazu und 15 Minuten köcheln. Aus Butter, Mehl und Milch eine Béchamel rühren. Abwechselnd schichten, mit Käse bestreuen und 35 Minuten bei 180 °C backen."
  },
  {
   "id": "brokkolipasta",
   "name": "Brokkoli-Sahne-Penne",
   "min": 25,
   "ing": {
    "penne": 125,
    "brokkoli": 0.5,
    "sahne": 70,
    "frischkaese": 30,
    "knoblauch": 1,
    "oel": 5
   },
   "steps": "Penne kochen, Brokkoliröschen die letzten 4 Minuten mitgaren. Knoblauch in Öl anschwitzen, Sahne und Frischkäse einrühren, alles mischen und pfeffern."
  },
  {
   "id": "wraps",
   "name": "Hähnchen-Wraps mit Gurke",
   "min": 25,
   "ing": {
    "wraps": 2,
    "haehnchen": 120,
    "paprika": 0.33,
    "gurke": 0.25,
    "salat": 0.15,
    "frischkaese": 30,
    "oel": 5
   },
   "steps": "Hähnchen in Streifen braten und würzen. Wraps kurz erwärmen, mit Frischkäse bestreichen und mit Salat, Gurke, Paprika und Hähnchen füllen."
  },
  {
   "id": "bratreis",
   "name": "Gebratener Reis mit Gemüse und Ei",
   "min": 25,
   "ing": {
    "reis": 80,
    "erbsen": 60,
    "karotten": 70,
    "eier": 1.5,
    "fzwiebel": 0.3,
    "oel": 10
   },
   "steps": "Reis kochen und abkühlen lassen (am besten vom Vortag). Karotten und Erbsen anbraten, Reis dazu und knusprig braten. Eier unterrühren, mit Frühlingszwiebeln bestreuen."
  },
  {
   "id": "tofu",
   "name": "Tofu-Gemüse-Pfanne mit Reis",
   "min": 30,
   "ing": {
    "tofu": 130,
    "brokkoli": 0.3,
    "paprika": 0.5,
    "soja": 15,
    "reis": 80,
    "knoblauch": 1,
    "oel": 15
   },
   "steps": "Tofu würfeln und rundum knusprig braten. Brokkoli, Paprika und Knoblauch mitbraten, mit Sojasauce ablöschen. Mit Reis servieren."
  },
  {
   "id": "kichercurry",
   "name": "Kichererbsen-Spinat-Curry",
   "min": 30,
   "ing": {
    "kicher": 130,
    "kokos": 100,
    "spinat": 80,
    "tomdose": 100,
    "zwiebeln": 40,
    "reis": 70,
    "oel": 10
   },
   "steps": "Zwiebel anbraten, Currypulver kurz mitrösten. Kichererbsen, Tomaten, Kokosmilch und Spinat dazu und 15 Minuten köcheln. Mit Reis servieren."
  },
  {
   "id": "kartspeck",
   "name": "Kartoffelsuppe mit Speck",
   "min": 40,
   "ing": {
    "kartoffeln": 300,
    "karotten": 60,
    "lauch": 0.3,
    "speck": 40,
    "bruehe": 6,
    "oel": 5
   },
   "steps": "Speck auslassen, Lauch und Karotten kurz mitdünsten. Gewürfelte Kartoffeln und Brühe dazu, 20 Minuten kochen und grob stampfen."
  },
  {
   "id": "kartlauch",
   "name": "Kartoffel-Lauch-Suppe",
   "min": 35,
